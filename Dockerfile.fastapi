# Use official Python 3.12 image
FROM python:3.12-slim

# Set working directory
WORKDIR /app/server

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY requirements_copy.txt .

# Install uv and upgrade pip
RUN pip install --upgrade pip && \
    pip install uv

# Install dependencies with --system flag
RUN uv pip install --system -r requirements_copy.txt

# Copy the rest of the FastAPI application
COPY src/server/ .

# Set PYTHONPATH to include the parent directory
ENV PYTHONPATH=/app

# Expose port
EXPOSE 8080

# Run FastAPI
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]